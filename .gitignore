# CMake / build outputs (ProjectData/build also has its own .gitignore)
ProjectData/build/*
!ProjectData/build/.gitignore
build/
out/
CMakeUserPresets.json

# Local sample and test drawings (not distributed)
/ProjectData/SampleDXF/

# IDE
.vs/
.vscode/
.cursor/

# Python
__pycache__/
*.py[cod]

# Atmel/Microchip Studio build outputs (keep generated Makefile + makedep.mk)
/Firmware/ClearCoreFirmware/Debug/*
/Firmware/ClearCoreFirmware/Release/*
/libClearCore/Debug/*
/libClearCore/Release/*
/LwIP/Debug/*
/LwIP/Release/*
!/Firmware/ClearCoreFirmware/Debug/Makefile
!/Firmware/ClearCoreFirmware/Debug/makedep.mk
!/Firmware/ClearCoreFirmware/Release/Makefile
!/Firmware/ClearCoreFirmware/Release/makedep.mk
!/libClearCore/Debug/Makefile
!/libClearCore/Debug/makedep.mk
!/libClearCore/Release/Makefile
!/libClearCore/Release/makedep.mk
!/LwIP/Debug/Makefile
!/LwIP/Debug/makedep.mk
!/LwIP/Release/Makefile
!/LwIP/Release/makedep.mk

# Host test build
/Firmware/tests/build/
